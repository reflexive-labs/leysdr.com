---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Shot from '@/components/Shot.astro';
import Features from '@/components/Features.astro';
import Ways from '@/components/Ways.astro';
import Need from '@/components/Need.astro';
import Download from '@/components/Download.astro';
import Footer from '@/components/Footer.astro';
---

<Base>
  <Hero />
  <main>
    <section id="app" class="app">
      <div class="wrap section-head intro">
        <h2 class="h2" style="max-width:16ch">
          Launch it, click a signal, hear it.
        </h2>
        <p class="lede">
          Connect a radio and the spectrum and waterfall appear. Click a signal to tune; Leyline
          sets mode, bandwidth and squelch for the band. Pan and zoom the band rail to explore
          nearby signals. The inspector shows signal levels and the tone it hears, with tuning
          controls beside them.
        </p>
      </div>
      <div class="wrap">
        <Shot name="app-radio-2m" frame="none" class="window" />
      </div>
    </section>
    <Features />
    <Ways />
    <Need />
    <Download />
  </main>
  <Footer />
</Base>

<script>
  import { initRadio } from '@/scripts/radio';
  initRadio();
</script>

<style>
  .app {
    padding-top: var(--section-space);
  }

  .intro {
    padding-bottom: 36px;
  }

  .app :global(.window) {
    margin: 0 auto;
    filter: drop-shadow(0 40px 60px rgb(0 0 0 / 60%));
  }
</style>
