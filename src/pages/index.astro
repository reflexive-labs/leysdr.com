---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Shot from '@/components/Shot.astro';
import Features from '@/components/Features.astro';
import Ways from '@/components/Ways.astro';
import Need from '@/components/Need.astro';
import Download from '@/components/Download.astro';
import Footer from '@/components/Footer.astro';
---

<Base>
  <Hero />
  <main>
    <section id="app" class="app">
      <div class="wrap section-head intro">
        <h2 class="h2" style="max-width:16ch">
          Launch it, click a signal, hear it.
        </h2>
        <p class="lede">
          The spectrum and waterfall appear as soon as a radio is connected. Click to tune; mode,
          bandwidth and squelch come from the band you’re in. The inspector shows the signal,
          tuning, deviation and the tone it hears, and the Library holds everything you’ve recorded.
        </p>
      </div>
      <div class="wrap">
        <Shot name="app-radio-2m" frame="none" class="window" />
      </div>
    </section>
    <Features />
    <Ways />
    <Need />
    <Download />
  </main>
  <Footer />
</Base>

<script>
  import { initRadio } from '@/scripts/radio';
  initRadio();
</script>

<style>
  .app {
    padding-top: 120px;
  }

  .intro {
    padding-bottom: 36px;
  }

  .app :global(.window) {
    margin: 0 auto;
    filter: drop-shadow(0 40px 60px rgb(0 0 0 / 60%));
  }
</style>
