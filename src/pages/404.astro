---
import Base from '@/layouts/Base.astro';
import Mark from '@/components/Mark.astro';
---

<Base title="Not found — Leyline SDR" description="This page doesn’t exist.">
  <main class="wrap nf">
    <a href="/" class="brand">
      <Mark size={26} stroke={1.5} />
      <span>leyline</span>
    </a>
    <span class="mono code">404 · no carrier</span>
    <h1>Nothing on this frequency.</h1>
    <p>The page you were looking for isn’t here.</p>
    <a href="/" class="btn btn-primary">
      Back to leysdr.com
    </a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 22px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--accent);
    margin-bottom: 24px;
  }

  .brand span {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--text);
  }

  .code {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--teal);
  }

  h1 {
    margin: 0;
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
  }
</style>
