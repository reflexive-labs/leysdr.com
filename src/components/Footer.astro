---
import Mark from './Mark.astro';
import { site } from '@/config/site';
---

<footer class="footer">
  <div class="wrap inner">
    <div class="lockup">
      <div class="word">
        <Mark size={26} stroke={1.5} />
        <span>leyline</span>
      </div>
      <div class="tag mono">
        <span class="rule"></span>
        <span>SOFTWARE DEFINED RADIO</span>
        <span class="rule"></span>
      </div>
    </div>
    <div class="row">
      <p>
        <strong>Receive only.</strong> Leyline has no transmit path. Listening is legal in most
        places, but some countries and states restrict decoding, recording or sharing certain
        transmissions. Check the rules where you are.
      </p>
      <nav class="mono" aria-label="Footer">
        <a
          href={site.links.download}
          class="first"
          data-track="download_clicked"
          data-placement="footer"
        >
          download
        </a>
        <a href={site.links.docs}>docs</a>
        <a href={site.links.repo}>github ↗</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 140px;
    border-top: 1px solid var(--line);
  }

  .inner {
    padding-top: 64px;
    padding-bottom: 72px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .lockup {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .word {
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--accent);
  }

  .word span {
    font-size: 62px;
    font-weight: 500;
    letter-spacing: -2.48px;
    line-height: 1;
    color: var(--text);
  }

  .tag {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 11px;
    letter-spacing: 4.62px;
    color: var(--dim);
  }

  .rule {
    width: 56px;
    height: 1px;
    background: var(--line-4);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 28px 56px;
    font-size: 14px;
    line-height: 1.6;
  }

  p {
    flex: 1 1 320px;
    max-width: 56ch;
    margin: 0;
    color: var(--muted);
    text-wrap: pretty;
  }

  strong {
    font-weight: 400;
    color: var(--text);
  }

  nav {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12px;
  }

  nav a {
    color: var(--muted);
  }

  nav a.first,
  nav a:hover {
    color: var(--text);
  }
</style>
