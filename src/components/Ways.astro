---
import Shot from './Shot.astro';
import ShotDisclosure from './ShotDisclosure.astro';
import { site } from '@/config/site';
---

<section id="ways" class="wrap ways">
  <div class="section-head">
    <h2 class="h2" style="max-width:18ch">
      One radio. Three ways to use it.
    </h2>
    <p class="lede">
      The Mac app, the <span class="mono ley">ley</span> command and MCP clients use the same
      background engine. Tune from the terminal or the assistant and the window follows, audio
      included. One dongle has one tuning: before moving it, Leyline names what would pause. When a
      decoder that took the radio stops, the radio returns to its previous tuning.
    </p>
  </div>

  <div class="cards">
    <div class="card">
      <div class="card-head">
        <span class="label mono">The app</span>
        <span class="desc">
          Click the waterfall to tune. Radio, Library and Decoders keep listening, recordings and
          decoded messages in reach.
        </span>
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <span class="label mono">The terminal</span>
        <span class="desc">
          Use <span class="mono code">ley</span> for scripts, cron jobs and SSH, with{' '}
          <span class="mono code">--json</span> for results. Preview radio changes with{' '}
          <span class="mono code">--dry-run</span>.
        </span>
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <span class="label mono">The assistant</span>
        <span class="desc">
          Ask in the app, or connect an external assistant with{' '}
          <span class="mono code">ley mcp</span>. Each step stays visible.
        </span>
      </div>
    </div>
  </div>

  <Shot
    name="app-follow-terminal"
    frame="none"
    caption="Tune from the terminal and the window follows. Simulated signals."
  />

  <ShotDisclosure
    label="See how Leyline shares the radio"
    name="app-move-radio"
    caption="Before a band sweep pauses APRS, Leyline names the decoder and its frequency. Simulated signals."
  >
    <Shot
      name="ley-dry-run"
      frame="terminal"
      caption="Preview a decoder start: this one would share the existing capture without retuning. Simulated signals."
    />
  </ShotDisclosure>

  <a
    href={site.links.docs}
    class="mono docs"
    data-track="documentation_opened"
    data-placement="ways_section"
  >
    Read the docs for ley and MCP →
  </a>
</section>

<style>
  .ways {
    padding-top: var(--section-space);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .ley {
    font-size: 14px;
    color: var(--text-2);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line-3);
    border-radius: 11px;
    overflow: hidden;
    background: var(--surface);
  }

  .card-head {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .label {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .desc {
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .code {
    font-size: 13px;
    white-space: nowrap;
  }

  .docs {
    align-self: flex-start;
    font-size: 12px;
  }
  @media (max-width: 899px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
