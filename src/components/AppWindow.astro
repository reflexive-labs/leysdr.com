---
// A static rendering of the Mac app's Radio view. The waterfall canvas is
// animated by src/scripts/radio.ts.
const peak = 26;
const bars = Array.from({ length: 64 }, (_, i) => {
  const d = Math.abs(i - peak);
  const h = i === peak ? 90 : d === 1 ? 52 : i === 54 ? 40 : i === 41 ? 24 : 8 + ((i * 37) % 11);
  return { h, c: i === peak ? 'var(--accent)' : h > 20 ? 'var(--teal)' : 'var(--teal-deep)' };
});

const bands = [
  { name: '2 m amateur', f: '144', active: true },
  { name: 'Calling', f: '146.520', sub: true },
  { name: 'APRS', f: '144.390', sub: true },
  { name: 'NERT net', f: '147.555', sub: true },
  { name: 'Marine VHF', f: '156' },
  { name: 'NOAA weather', f: '162' },
  { name: '70 cm amateur', f: '420' },
  { name: 'GMRS', f: '462' },
];

const signal = [
  ['Level', '−39 dBFS'],
  ['Tuning error', '+0.4 kHz'],
  ['Deviation', '4.1 kHz'],
  ['Tone', 'PL 100.0'],
];

const recent = [
  ['21:42:07', '0.3 s'],
  ['21:41:52', '6.8 s'],
  ['21:40:19', '11.2 s'],
];
---

<div class="scroller">
  <div
    class="win"
    role="img"
    aria-label="The Leyline app tuned to 146.520 MHz NFM, with spectrum, waterfall and signal inspector"
  >
    <div class="titlebar" aria-hidden="true">
      <span class="light" style="background:#FF5F57"></span>
      <span class="light" style="background:#FEBC2E"></span>
      <span class="light" style="background:#28C840"></span>
      <span style="width:10px"></span>
      <div class="seg">
        <span class="on">Radio</span>
        <span>Library</span>
      </div>
      <span style="flex:1"></span>
      <span class="device">
        <span class="dot"></span>NESDR SMArt v5<span class="chev">⌄</span>
      </span>
      <span class="sidebar-btn">
        <span class="icon">
          <span></span>
        </span>
      </span>
    </div>
    <div class="main" aria-hidden="true">
      <div class="sidebar">
        <div class="group">Bands</div>
        {bands.map((b) => (
          <div class:list={['band', { active: b.active, sub: b.sub }]}>
            <span>{b.name}</span>
            <span class="mac-mono f">{b.f}</span>
          </div>
        ))}
      </div>
      <div class="center">
        <div class="tuned">
          <span class="freq">
            146.520<span class="mac-mono unit">MHz</span>
          </span>
          <span class="mode">NFM</span>
          <span style="flex:1"></span>
          <span class="mac-mono level">−39 dBFS</span>
        </div>
        <div class="spectrum">
          {bars.map((b) => (
            <div style={`height:${b.h}%;background:${b.c}`} />
          ))}
        </div>
        <canvas data-waterfall width="600" height="260"></canvas>
        <div class="axis mac-mono">
          <span>145.320</span>
          <span>146.520</span>
          <span>147.720</span>
        </div>
      </div>
      <div class="inspector">
        <div class="stack">
          <span class="group">Signal</span>
          {signal.map(([k, v]) => (
            <div class="row">
              <span class="k">{k}</span>
              <span class:list={['mac-mono', { teal: k === 'Tone' }]}>{v}</span>
            </div>
          ))}
        </div>
        <div class="sep"></div>
        <div class="stack">
          <span class="group">Recent transmissions</span>
          {recent.map(([t, d]) => (
            <div class="row mac-mono small">
              <span class="t">{t}</span>
              <span class="k">{d}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .scroller {
    max-width: 1264px;
    margin: 0 auto;
    padding: 0 var(--gutter);
    overflow-x: auto;
  }

  .win {
    min-width: 940px;
    border: 1px solid var(--line-3);
    border-radius: 11px;
    overflow: hidden;
    background: var(--bg);
    box-shadow: 0 50px 100px -40px rgb(0 0 0 / 95%);
    font-family: var(--font-mac);
  }

  .titlebar {
    height: 52px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 12px 0 18px;
    background: var(--surface);
    border-bottom: 1px solid var(--line-2);
  }

  .light {
    width: 12px;
    height: 12px;
    flex: none;
    border-radius: 50%;
  }

  .seg {
    display: flex;
    gap: 2px;
    padding: 2px;
    border-radius: 7px;
    background: var(--surface-3);
    border: 1px solid #1f2427;
    font-size: 12.5px;
  }

  .seg span {
    padding: 4px 13px;
    border-radius: 5px;
    color: var(--muted-2);
  }

  .seg .on {
    background: var(--surface-sel);
    color: var(--text-bright);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 45%),
      inset 0 0 0 0.5px rgb(255 255 255 / 8%);
  }

  .device {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 4px 11px;
    border-radius: 7px;
    background: var(--surface-3);
    font-size: 12.5px;
    white-space: nowrap;
  }

  .dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background: var(--teal);
  }

  .chev {
    color: var(--faint);
    font-size: 10px;
  }

  .sidebar-btn {
    width: 30px;
    height: 24px;
    flex: none;
    border-radius: 6px;
    background: var(--surface-3);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon {
    width: 15px;
    height: 11px;
    border: 1.3px solid var(--text-4);
    border-radius: 2.5px;
    position: relative;
  }

  .icon span {
    position: absolute;
    right: 3px;
    top: 0;
    bottom: 0;
    width: 1.3px;
    background: var(--text-4);
  }

  .main {
    display: flex;
    height: 440px;
  }

  .sidebar {
    width: 210px;
    flex: none;
    background: var(--surface);
    border-right: 1px solid var(--line-2);
    padding: 14px 10px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 13px;
  }

  .group {
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 600;
    color: var(--faint);
  }

  .inspector .group {
    padding: 0;
  }

  .band {
    padding: 6px 10px;
    border-radius: 6px;
    color: var(--text-4);
    display: flex;
    justify-content: space-between;
  }

  .band .f {
    font-size: 11px;
    color: var(--faint);
  }

  .band.active {
    background: var(--surface-hi);
    color: var(--text-bright);
  }

  .band.active .f {
    color: var(--muted-2);
  }

  .band.sub {
    padding: 5px 10px 5px 22px;
    font-size: 12.5px;
  }

  .center {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .tuned {
    padding: 18px 22px 14px;
    display: flex;
    align-items: baseline;
    gap: 14px;
    border-bottom: 1px solid var(--line);
  }

  .freq {
    font-family: var(--font-sans);
    font-size: 30px;
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .unit {
    font-size: 13px;
    color: var(--muted-2);
    padding-left: 7px;
    letter-spacing: 0;
  }

  .mode {
    font-size: 12px;
    color: var(--text-4);
    padding: 2px 7px;
    border: 1px solid var(--line-4);
    border-radius: 5px;
  }

  .level {
    font-size: 12px;
    color: var(--teal);
  }

  .spectrum {
    height: 96px;
    display: flex;
    align-items: flex-end;
    gap: 1px;
    padding: 0 0 1px;
    border-bottom: 1px solid var(--line);
  }

  .spectrum div {
    flex: 1;
  }

  canvas {
    display: block;
    width: 100%;
    flex: 1;
    min-height: 0;
  }

  .axis {
    display: flex;
    justify-content: space-between;
    padding: 6px 14px;
    font-size: 10px;
    color: var(--faint);
    border-top: 1px solid var(--line);
  }

  .inspector {
    width: 260px;
    flex: none;
    background: var(--surface);
    border-left: 1px solid var(--line-2);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 12.5px;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .row {
    display: flex;
    justify-content: space-between;
  }

  .row.small {
    font-size: 11.5px;
  }

  .k {
    color: var(--muted-2);
  }

  .t {
    color: var(--text-4);
  }

  .sep {
    height: 1px;
    background: var(--line-2);
  }
</style>
