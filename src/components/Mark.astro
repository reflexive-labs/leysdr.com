---
// The leyline mark: a ring with a centre dot. Inherits currentColor.
// Drawn on a 26-unit grid; `stroke` is in those units.
interface Props {
  size?: number;
  stroke?: number;
}

const { size = 13, stroke = 1.6 } = Astro.props;
const r = 13 - stroke / 2 - 0.25;
---

<svg viewBox="0 0 26 26" width={size} height={size} aria-hidden="true" style="display:block">
  <circle cx="13" cy="13" r={r} fill="none" stroke="currentColor" stroke-width={stroke}></circle>
  <circle cx="13" cy="13" r="3" fill="currentColor"></circle>
</svg>
